{
  "name": "@cookievault/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared schemas, crypto primitives, and cross-app types for CookieVault.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./crypto": "./src/crypto/index.ts",
    "./profile": "./src/profile/index.ts",
    "./profile/strength": "./src/profile/strength.ts",
    "./sync": "./src/sync/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
